# --- App ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://127.0.0.1:5173
# Proxies in front of the server (load balancers): 1 on Render, false locally. The rate limits
# then count each client's own address. Never "true": clients could fake their address.
TRUST_PROXY=false

# --- Database (PostgreSQL) ---
# `npm run db:setup` creates this role and database on the local server.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=zeechart
DB_LOGGING=false
# SSL to the database: false (local), true (managed hosts such as Neon or Railway), or no-verify
# (encrypted but the certificate is not checked, e.g. Supabase's pooler).
DB_SSL=false

# --- Auth ---
# Signs sign-in tokens: anyone who knows it can sign in as any user. Required everywhere except
# tests (development too): 32+ random characters, different for every environment. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# How long a sign-in lasts: 7d, 12h, ...
JWT_EXPIRES_IN=7d
