# Copy to .env and fill in values. Never commit real secrets.
# Validated at startup by src/config/env.validation.ts.

# --- App ---
NODE_ENV=development
PORT=3000
# Frontend origin allowed by CORS
CORS_ORIGIN=http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
# `npm run db:setup` creates this role and database on the local server.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=zeechart
DB_PASSWORD=change-me
DB_NAME=zeechart
DB_LOGGING=false

# --- OpenAI ---
OPENAI_API_KEY=
