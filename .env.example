# --- App ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
# `npm run db:setup` creates this role and database on the local server.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=zeechart
DB_LOGGING=false
# SSL to the database: false (local), true (managed hosts such as Neon or Railway), or no-verify
# (encrypted but the certificate is not checked, e.g. Supabase's pooler).
DB_SSL=false

# --- Auth ---
# Signs sign-in tokens. Required in production: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Optional in development (a fixed dev value is used when unset).
# JWT_SECRET=
# How long a sign-in lasts: 7d, 12h, ...
JWT_EXPIRES_IN=7d
