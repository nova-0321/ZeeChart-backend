  "info": {
    "title": "ZeeChart API",
    "description": "",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always \"ok\" when the service is up.",
            "enum": [
              "ok"
            ]
          },
          "uptime": {
            "type": "number",
            "description": "Process uptime in seconds."
          },
          "timestamp": {
            "type": "string",
            "description": "Server time (ISO 8601)."
          }
        },
        "required": [
          "status",
          "uptime",
          "timestamp"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "archived",
          "tasks",
          "createdAt",
          "updatedAt"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "progress": {
            "type": "number"
          },
          "projectId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "startDate": {
            "format": "date-time",
            "type": "string"
          },
          "endDate": {
            "format": "date-time",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "parent": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Task"
              }
            ]
          },
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        },
        "required": [
          "id",
          "name",
          "progress",
          "projectId",
          "type",
          "priority",
          "startDate",
          "endDate",
          "createdAt",
          "color",
          "order",
          "updatedAt",
          "parentId",
          "parent",
          "project",
          "children"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "TaskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Defaults to \"task\".",
            "enum": [
              "group",
              "task",
              "milestone"
            ]
          },
          "startDate": {
            "format": "date-time",
            "type": "string",
            "description": "\"YYYY-MM-DD\" (a full ISO date-time is accepted too)."
          },
          "endDate": {
            "format": "date-time",
            "type": "string",
            "description": "\"YYYY-MM-DD\". Must not be before startDate."
          },
          "progress": {
            "type": "number",
            "description": "0 to 100. Defaults to 0.",
            "minimum": 0,
            "maximum": 100
          },
          "priority": {
            "type": "string",
            "description": "Defaults to \"medium\".",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "color": {
            "type": "string",
            "description": "A hex color such as \"#2a78d6\".",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "order": {
            "type": "number",
            "description": "Position among the project's tasks. Defaults to the end of the list.",
            "minimum": 0
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": "string",
            "nullable": true,
            "description": "The group this task belongs to. Leave out (or null) for a top-level task.",
            "format": "uuid"
          }
        },
        "required": [
          "name",
          "startDate",
          "endDate",
          "color",
          "projectId"
        ]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "startDate": {
            "format": "date-time",
            "type": "string",
            "description": "\"YYYY-MM-DD\" (a full ISO date-time is accepted too)."
          },
          "endDate": {
            "format": "date-time",
            "type": "string",
            "description": "\"YYYY-MM-DD\". Must not be before startDate."
          },
          "progress": {
            "type": "number",
            "description": "0 to 100. Defaults to 0.",
            "minimum": 0,
            "maximum": 100
          },
          "priority": {
            "description": "Defaults to \"medium\".",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "A hex color such as \"#2a78d6\".",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      },
      "SetParentDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "nullable": true,
            "description": "Id of the group to move the task under, or null to make it top-level.",
            "format": "uuid"
          }
        },
        "required": [
          "parentId"
        ]
      },
      "ChangeTypeDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "group",
              "task",
              "milestone"
            ]
          }
        },
        "required": [
          "type"
        ]
      }
    }
  }
}
