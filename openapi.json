  "info": {
    "title": "ZeeChart API",
    "description": "",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always \"ok\" when the service is up.",
            "enum": [
              "ok"
            ]
          },
          "uptime": {
            "type": "number",
            "description": "Process uptime in seconds."
          },
          "timestamp": {
            "type": "string",
            "description": "Server time (ISO 8601)."
          }
        },
        "required": [
          "status",
          "uptime",
          "timestamp"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "progress": {
            "type": "number"
          },
          "projectId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "startDate": {
            "format": "date-time",
            "type": "string"
          },
          "endDate": {
            "format": "date-time",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "parent": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Task"
              }
            ]
          },
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        },
        "required": [
          "id",
          "name",
          "progress",
          "projectId",
          "type",
          "priority",
          "startDate",
          "endDate",
          "createdAt",
          "color",
          "order",
          "updatedAt",
          "parentId",
          "parent",
          "project",
          "children"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "archived",
          "tasks",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProjectEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "description": "First day of the event."
          },
          "endDate": {
            "type": "string",
            "description": "Last day of the event (included)."
          },
          "projectId": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "project": {
            "$ref": "#/components/schemas/Project"
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "startDate",
          "endDate",
          "projectId",
          "createdAt",
          "updatedAt",
          "project"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "color": {
            "type": "string",
            "description": "A hex color such as \"#e5484d\".",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "startDate": {
            "type": "string",
            "description": "\"YYYY-MM-DD\": the first day."
          },
          "endDate": {
            "type": "string",
            "description": "\"YYYY-MM-DD\": the last day. Must not be before startDate."
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "name",
          "color",
          "startDate",
          "endDate",
          "projectId"
        ]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "color": {
            "type": "string",
            "description": "A hex color such as \"#e5484d\".",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "startDate": {
            "type": "string",
            "description": "\"YYYY-MM-DD\": the first day."
          },
          "endDate": {
            "type": "string",
            "description": "\"YYYY-MM-DD\": the last day. Must not be before startDate."
          }
        }
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "TaskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Defaults to \"task\".",
            "enum": [
              "group",
              "task",
              "milestone"
            ]
          },
          "startDate": {
            "format": "date-time",
            "type": "string",
            "description": "\"YYYY-MM-DD\" (a full ISO date-time is accepted too)."
          },
          "endDate": {
            "format": "date-time",
            "type": "string",
            "description": "\"YYYY-MM-DD\". Must not be before startDate."
          },
          "progress": {
            "type": "number",
            "description": "0 to 100. Defaults to 0.",
            "minimum": 0,
            "maximum": 100
          },
          "priority": {
            "type": "string",
            "description": "Defaults to \"medium\".",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "color": {
            "type": "string",
            "description": "A hex color such as \"#2a78d6\".",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "order": {
            "type": "number",
            "description": "Position among the project's tasks. Defaults to the end of the list.",
            "minimum": 0
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": "string",
            "nullable": true,
            "description": "The group this task belongs to. Leave out (or null) for a top-level task.",
            "format": "uuid"
          }
        },
        "required": [
          "name",
          "startDate",
          "endDate",
          "color",
          "projectId"
        ]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "startDate": {
            "format": "date-time",
            "type": "string",
            "description": "\"YYYY-MM-DD\" (a full ISO date-time is accepted too)."
          },
          "endDate": {
            "format": "date-time",
            "type": "string",
            "description": "\"YYYY-MM-DD\". Must not be before startDate."
          },
          "progress": {
            "type": "number",
            "description": "0 to 100. Defaults to 0.",
            "minimum": 0,
            "maximum": 100
          },
          "priority": {
            "description": "Defaults to \"medium\".",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "A hex color such as \"#2a78d6\".",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      },
      "SetParentDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "nullable": true,
            "description": "Id of the group to move the task under, or null to make it top-level.",
            "format": "uuid"
          }
        },
        "required": [
          "parentId"
        ]
      },
      "MoveTaskDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "nullable": true,
            "description": "Id of the group the task goes in, or null for the top level.",
            "format": "uuid"
          },
          "index": {
            "type": "number",
            "description": "Its place among the tasks of that group (or of the top level), counting from 0.",
            "minimum": 0
          }
        },
        "required": [
          "parentId",
          "index"
        ]
      },
      "ChangeTypeDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "group",
              "task",
              "milestone"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "TaskDependency": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "fromTaskId": {
            "type": "string",
            "description": "The predecessor."
          },
          "toTaskId": {
            "type": "string",
            "description": "The successor."
          },
          "type": {
            "type": "string"
          },
          "lagDays": {
            "type": "number",
            "description": "Days the successor waits after the predecessor; negative lets them overlap."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "fromTask": {
            "$ref": "#/components/schemas/Task"
          },
          "toTask": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "id",
          "projectId",
          "fromTaskId",
          "toTaskId",
          "type",
          "lagDays",
          "createdAt",
          "fromTask",
          "toTask"
        ]
      },
      "DependencyDto": {
        "type": "object",
        "properties": {
          "lagDays": {
            "type": "number",
            "minimum": -365,
            "maximum": 365
          },
          "fromTaskId": {
            "type": "string",
            "description": "The predecessor task.",
            "format": "uuid"
          },
          "toTaskId": {
            "type": "string",
            "description": "The successor task: it comes after the predecessor.",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "description": "Defaults to \"FS\" (finish to start).",
            "enum": [
              "FS",
              "SS",
              "FF",
              "SF"
            ]
          }
        },
        "required": [
          "fromTaskId",
          "toTaskId"
        ]
      },
      "UpdateDependencyDto": {
        "type": "object",
        "properties": {
          "lagDays": {
            "type": "number",
            "minimum": -365,
            "maximum": 365
          },
          "type": {
            "description": "Defaults to \"FS\" (finish to start).",
            "enum": [
              "FS",
              "SS",
              "FF",
              "SF"
            ],
            "type": "string"
          }
        }
      }
    }
  }
}
